$TTL 86400
@ IN SOA attacker.local. admin.attacker.local. (
    2023072301 ; Serial
    3600       ; Refresh
    1800       ; Retry
    1209600    ; Expire
    86400      ; Minimum TTL
)

; Name servers
@ IN NS ns1.attacker.local.
@ IN NS ns2.attacker.local.

; Mail servers
@ IN MX 10 mail.attacker.local.
@ IN MX 20 mail2.attacker.local.

; Main records
@ IN A 172.16.0.10
ns1 IN A 172.16.0.10
ns2 IN A 172.16.0.11
mail IN A 172.16.0.12
mail2 IN A 172.16.0.13

; C&C communication records
cmd IN A 172.16.0.10
exfil IN A 172.16.0.10
tunnel IN A 172.16.0.10
cc IN A 172.16.0.10

; Reconnaissance records
admin IN A 172.16.0.20
api IN A 172.16.0.21
db IN A 172.16.0.22
internal IN A 172.16.0.23

; TXT records for data exfiltration
data IN TXT "exfiltration_data_placeholder"
status IN TXT "command_executed_successfully"
result IN TXT "attack_phase_completed"

; Wildcard for dynamic subdomains
* IN A 172.16.0.10 