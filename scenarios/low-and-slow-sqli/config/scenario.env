# SecurityLogs Scenario Configuration
# Low-and-Slow SQL Injection Attack Scenario

# =============================================================================
# SCENARIO IDENTITY
# =============================================================================
SCENARIO_NAME=low-and-slow-sqli
SCENARIO_VERSION=1.0.0
SCENARIO_DESCRIPTION="Low-and-slow web scanning with covert SQL injection"

# =============================================================================
# CONTAINER CONFIGURATION
# =============================================================================
WEBAPP_IMAGE=securitylogs-webapp
ATTACKER_IMAGE=securitylogs-attacker
TCPDUMP_IMAGE=securitylogs-tcpdump
DATABASE_IMAGE=mysql:8.0

# Container versions for reproducibility
WEBAPP_VERSION=latest
ATTACKER_VERSION=latest
TCPDUMP_VERSION=latest
DATABASE_VERSION=8.0

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================
NETWORK_NAME=securitylogs_attacknet
NETWORK_SUBNET=172.20.0.0/16
NETWORK_GATEWAY=172.20.0.1

# Target configuration
TARGET_HOST=victim-web
TARGET_PORT=80
TARGET_URL=http://victim-web
DATABASE_HOST=database
DATABASE_PORT=3306

# =============================================================================
# ATTACK CONFIGURATION
# =============================================================================
# Default attack parameters (can be overridden by variants)
DEFAULT_NMAP_RATE=0.016
DEFAULT_SQL_DELAY=120
DEFAULT_SQLMAP_THREADS=1
DEFAULT_SQLMAP_RISK=1
DEFAULT_SQLMAP_LEVEL=1

# Attack timing
ATTACK_START_DELAY=60
ATTACK_PHASE_DELAY=30
ATTACK_TOTAL_DURATION=1800

# =============================================================================
# BENIGN TRAFFIC CONFIGURATION
# =============================================================================
# Protocol mix for background traffic
DEFAULT_PROTOCOL_MIX=HTTP:0.7,DNS:0.2,SMTP:0.1

# Benign traffic timing
BENIGN_START_DELAY=30
BENIGN_TOTAL_DURATION=2400
BENIGN_REQUEST_INTERVAL=2

# =============================================================================
# NETWORK EMULATION CONFIGURATION
# =============================================================================
# Default network profile
DEFAULT_NETEM_PROFILE=low_latency

# Network emulation timing
NETEM_APPLY_DELAY=10
NETEM_RESET_DELAY=60

# =============================================================================
# LOGGING AND OUTPUT CONFIGURATION
# =============================================================================
# Output directories
PCAP_OUTPUT_DIR=pcap_data/low-and-slow-sqli
LOG_OUTPUT_DIR=logs/low-and-slow-sqli
RESULT_OUTPUT_DIR=output/low-and-slow-sqli

# Log levels
LOG_LEVEL=INFO
TCPDUMP_VERBOSE=true
ATTACKER_VERBOSE=true

# =============================================================================
# EXPERIMENT CONTROL
# =============================================================================
# Experiment timing
EXPERIMENT_TIMEOUT=3600
CLEANUP_DELAY=30

# Reproducibility settings
RANDOM_SEED=42
ENABLE_TIMESTAMPS=true
ENABLE_CHECKSUMS=true
