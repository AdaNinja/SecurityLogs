# Low-and-Slow SQL Injection Scenario Configuration
# Base configuration for SQL injection attack scenario

# Target Configuration
TARGET_HOST=victim-web
TARGET_PORT=80
TARGET_URL=http://victim-web/login.php

# Reconnaissance Configuration
NMAP_RATE=0.016
NMAP_STEALTH_LEVEL=1
HTTP_ENUM_SCRIPTS=true
PORT_SCAN_TIMEOUT=300

# SQL Injection Configuration
SQL_DELAY=120
SQLMAP_THREADS=1
SQLMAP_BATCH=true
INJECTION_POINTS=user,pass
DUMP_TABLES=users,admin,config
DUMP_COLUMNS=email,password,username,api_key
EXTRACT_BATCH_SIZE=2

# Background Traffic Configuration
USER_COUNT=5
PAGE_INTERVAL_MIN=30
PAGE_INTERVAL_MAX=120
BACKGROUND_PAGES=/,/products,/about,/contact,/login,/search

# Network Configuration
NETWORK_DELAY=100
PACKET_LOSS=1
JITTER=20
BANDWIDTH=10

# Attack Timing
ATTACK_DELAY=60
RECON_DURATION=300
INJECTION_DURATION=600

# Logging Configuration
LOG_LEVEL=INFO
CAPTURE_PCAP=true
SAVE_LOGS=true
