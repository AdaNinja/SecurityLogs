# Custom Suricata Rules for CyberRange Monitoring
# IDS mode only - no blocking actions

# HTTP-based attacks detection
alert http any any -> any any (msg:"HTTP SQL Injection Attempt"; flow:to_server,established; content:"'"; http_uri; content:"OR"; http_uri; content:"1=1"; http_uri; sid:1000001; rev:1;)

alert http any any -> any any (msg:"HTTP XSS Attempt"; flow:to_server,established; content:"<script>"; http_uri; sid:1000002; rev:1;)

alert http any any -> any any (msg:"HTTP Directory Traversal"; flow:to_server,established; content:"../"; http_uri; sid:1000003; rev:1;)

# Command injection detection
alert tcp any any -> any any (msg:"Command Injection - Basic"; content:"|3b|"; content:"cat"; content:"/etc/passwd"; sid:1000004; rev:1;)

alert tcp any any -> any any (msg:"Command Injection - whoami"; content:"|3b|"; content:"whoami"; sid:1000005; rev:1;)

# Reverse shell detection
alert tcp any any -> any any (msg:"Potential Reverse Shell"; content:"bash"; content:"-i"; sid:1000006; rev:1;)

alert tcp any any -> any any (msg:"Netcat Reverse Shell"; content:"nc"; content:"-e"; content:"bash"; sid:1000007; rev:1;)

# File access patterns
alert http any any -> any any (msg:"Suspicious File Access"; flow:to_server,established; content:"/etc/"; http_uri; sid:1000008; rev:1;)

alert http any any -> any any (msg:"Config File Access"; flow:to_server,established; content:".conf"; http_uri; sid:1000009; rev:1;)

# Botnet/C2 communication patterns
alert tcp any any -> any any (msg:"Suspicious Outbound Connection"; flow:from_server,established; dsize:>1000; sid:1000010; rev:1;)

# Crypto mining detection
alert tcp any any -> any any (msg:"Potential Crypto Mining"; content:"stratum"; sid:1000011; rev:1;)

# All rules are set to ALERT only - no DROP or REJECT actions
